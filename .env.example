DATABASE_URL=""

# Used only to bootstrap the first staff account — run
# `npx tsx prisma/create-admin.ts` after setting these (see Feature 9).
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"

# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=""

# Google sign-in for patients (Auth.js). Client ID/secret from Google
# Cloud Console -> APIs & Services -> Credentials. AUTH_SECRET generated
# with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
AUTH_SECRET=""
