generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Appointment {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String
  serviceId String
  dentistId String
  dentist   Dentist  @relation(fields: [dentistId], references: [id])
  // Nullable: appointments booked before patient accounts existed have no
  // owner to attribute them to. Booking now requires being signed in, so
  // every *new* row gets one — this stays optional only for that old data.
  // SetNull (not Cascade) on delete: if a patient account is ever removed,
  // the clinic keeps the appointment record, just no longer linked to an
  // account.
  patientId String?
  patient   Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)
  date      String
  time      String
  notes     String   @default("")
  createdAt DateTime @default(now())
}

// A dentist patients can book with. Kept in the database (unlike `services`,
// which is a static list in clinic-data.ts) because which dentists exist is
// operational data the clinic could change, not something baked into the
// app's code.
model Dentist {
  id           String        @id @default(uuid())
  name         String
  specialty    String
  createdAt    DateTime      @default(now())
  appointments Appointment[]
}

// One retrievable piece of clinic knowledge (an FAQ answer, a policy, etc.)
// plus its embedding — a list of numbers representing the meaning of
// `content`, produced by an embeddings model. Similar meanings produce
// similar (nearby) vectors, which is what makes semantic search possible.
model KnowledgeChunk {
  id        String   @id @default(uuid())
  topic     String
  content   String
  embedding Float[]
  createdAt DateTime @default(now())
}

// Someone who showed interest but didn't book — captured by the chatbot
// so staff can follow up personally. `status` starts at "new"; staff
// updates it manually once they've made contact.
model Lead {
  id        String   @id @default(uuid())
  name      String
  contact   String
  interest  String
  status    String   @default("new")
  createdAt DateTime @default(now())
}

// A clinic staff account. There's no public sign-up — accounts are created
// with prisma/create-admin.ts (see that file for why).
model StaffUser {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  sessions     Session[]
}

// A logged-in session. Storing these in the database (rather than only in
// a signed cookie) is what makes "log out" and "log out everywhere" real
// operations — deleting the row here immediately invalidates the session,
// no matter what the browser still has cached.
model Session {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  user      StaffUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())
}

// A patient's own account — separate from StaffUser on purpose. Patients
// self-register (there's a public sign-up), staff don't; and a patient
// session must never be usable to access /admin, so keeping the models (and
// their session tables) fully independent means there's no shared code path
// where that boundary could accidentally blur.
model Patient {
  id           String            @id @default(uuid())
  name         String
  email        String            @unique
  passwordHash String
  createdAt    DateTime          @default(now())
  sessions     PatientSession[]
  appointments Appointment[]
}

model PatientSession {
  id        String   @id @default(uuid())
  token     String   @unique
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}
